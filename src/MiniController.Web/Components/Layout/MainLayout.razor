@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject ISystemRegistry Registry

<div class="lcars">
    <div class="lcars-top">
        <div class="lcars-top__elbow"></div>
        <div class="lcars-top__bar">
            <span class="lcars-top__title">@_title</span>
        </div>
    </div>

    <div class="lcars-body">
        <nav class="lcars-rail">
            <NavMenu />
        </nav>
        <article class="lcars-content">
            @Body
        </article>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _title = "Systems";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _title = TitleForCurrentRoute();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _title = TitleForCurrentRoute();
        InvokeAsync(StateHasChanged);
    }

    private string TitleForCurrentRoute()
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');

        if (path == "/")
            return "Systems";

        foreach (var module in Registry.Modules)
        {
            if (path == module.Route)
                return module.Name;
            if (path.StartsWith(module.Route + "/", StringComparison.Ordinal))
            {
                var sub = path[(module.Route.Length + 1)..];
                if (sub.Length > 0)
                    return $"{module.Name} {char.ToUpperInvariant(sub[0])}{sub[1..]}";
            }
        }

        return "Systems";
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
